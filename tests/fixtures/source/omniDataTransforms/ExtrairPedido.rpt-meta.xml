<?xml version="1.0" encoding="UTF-8"?>
<!-- SIMULADO para testes. -->
<OmniDataTransform xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lê o pedido e a conta</description>
    <inputType>JSON</inputType>
    <isActive>true</isActive>
    <isFieldLevelSecurityEnabled>true</isFieldLevelSecurityEnabled>
    <name>ExtrairPedido</name>
    <omniDataTransformItem>
        <filterOperator>=</filterOperator>
        <filterValue>PedidoId</filterValue>
        <inputFieldName>Id</inputFieldName>
        <inputObjectName>Pedido__c</inputObjectName>
        <outputFieldName>Pedido</outputFieldName>
    </omniDataTransformItem>
    <omniDataTransformItem>
        <inputFieldName>Valor__c</inputFieldName>
        <inputObjectName>Pedido__c</inputObjectName>
        <outputFieldName>Pedido:Valor</outputFieldName>
    </omniDataTransformItem>
    <omniDataTransformItem>
        <formulaExpression>ROUND(Pedido:Valor, 2)</formulaExpression>
        <inputFieldName>Name</inputFieldName>
        <inputObjectName>Account</inputObjectName>
        <outputFieldName>Conta:Nome</outputFieldName>
    </omniDataTransformItem>
    <outputType>JSON</outputType>
    <type>Extract</type>
    <versionNumber>1</versionNumber>
</OmniDataTransform>

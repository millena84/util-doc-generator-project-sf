<?xml version="1.0" encoding="UTF-8"?>
<EscalationRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <escalationRule>
        <fullName>Escalonamento_Case</fullName>
        <active>true</active>
        <ruleEntry>
            <businessHoursSource>None</businessHoursSource>
            <criteriaItems>
                <field>Case.Priority</field>
                <operation>equals</operation>
                <value>High</value>
            </criteriaItems>
            <escalationAction>
                <assignedTo>Fila_Pedidos</assignedTo>
                <assignedToType>Queue</assignedToType>
                <minutesToEscalation>240</minutesToEscalation>
                <notifyCaseOwner>true</notifyCaseOwner>
                <notifyEmail>alerta.sentinela@example.invalid</notifyEmail>
                <notifyTo>gerente.sentinela@example.invalid</notifyTo>
                <notifyToTemplate>unfiled$public/Caso_Escalonado</notifyToTemplate>
            </escalationAction>
        </ruleEntry>
    </escalationRule>
</EscalationRules>

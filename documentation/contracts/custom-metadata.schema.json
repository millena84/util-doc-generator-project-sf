{
  "metadataType": "CustomMetadata",
  "apiVersion": "67.0",
  "documentStrategy": "ONE_DOCUMENT_PER_TYPE_AND_RECORDS",
  "xmlFilePattern": "**/*.md-meta.xml",
  "typeDefinition": {
    "metadataType": "CustomObject",
    "xmlFilePattern": "**/*__mdt.object-meta.xml"
  },
  "template": "modelo-doc-custom-metadata-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "notes": "Identificação vem do XML do tipo (CustomObject __mdt); Records vêm dos XMLs CustomMetadata.",
  "properties": [
    {
      "name": "DeveloperName",
      "placeholder": "developer_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "fullName do tipo (ex.: Config__mdt)."
    },
    {
      "name": "Label",
      "placeholder": "label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "PluralLabel",
      "placeholder": "plural_label",
      "path": "pluralLabel",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "Description",
      "placeholder": "description",
      "path": "description",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "Visibility",
      "placeholder": "visibility",
      "path": "visibility",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    }
  ],
  "tables": [
    {
      "markdownSection": "Campos do tipo",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "CustomField",
        "columns": {
          "field": "fullName",
          "label": "label",
          "type": "type"
        }
      }
    },
    {
      "markdownSection": "Records",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "CustomMetadata",
        "columns": {
          "record": "@fullName",
          "label": "label",
          "protected": "protected"
        }
      }
    },
    {
      "markdownSection": "Dados internos",
      "builder": "internal_record_properties",
      "source": "Tooling API",
      "args": {
        "keyPlaceholder": "internal_property",
        "valuePlaceholder": "internal_value"
      },
      "emptyValue": "Não informado"
    }
  ],
  "relatedMetadataTypes": [],
  "internalData": {
    "enabled": true,
    "source": "Tooling API",
    "object": "EntityDefinition",
    "useToolingApi": true,
    "query": "SELECT QualifiedApiName, Label, PluralLabel, KeyPrefix, LastModifiedDate FROM EntityDefinition WHERE QualifiedApiName = '{fullName}'",
    "expectSingleRecord": true,
    "blocking": false,
    "validationPending": "Campos conforme Tooling API e Field Reference (EntityDefinition); confirmar no piloto que a consulta é aceita pela org."
  },
  "referenceDoc": "_sf_utilities/ajudAI/contexto-custommetadata.md",
  "evidence": [
    "Metadata API CustomMetadata: records em customMetadata/, sufixo .md (o ajudAI cita .mdt — divergente)"
  ],
  "security": "Valores dos records (<values>) NÃO são renderizados: podem conter tokens, API keys ou URLs internas.",
  "notSupported": [
    "fieldManageability (SubscriberEditable/DeveloperEditable no ajudAI): enum oficial pendente",
    "Tipo de campo EntityDefinition do ajudAI: não confirmado"
  ]
}

{
  "metadataType": "Flow",
  "apiVersion": "67.0",
  "documentStrategy": "SUB_DOCUMENT_OF_FLOW",
  "xmlFilePattern": "**/*.flow-meta.xml",
  "template": "modelo-doc-flow-autolaunched-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "referenceDoc": "_sf_utilities/ajudAI/contexto-flow-autolaunched.md",
  "classification": "processType = AutoLaunchedFlow E start.triggerType ausente (config: subDocuments.when). Fluxos com triggerType geram o subdocumento flow-trigger.",
  "properties": [
    {
      "name": "DeveloperName",
      "placeholder": "developer_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "fullName do componente (nome do arquivo XML recuperado)."
    },
    {
      "name": "Label",
      "placeholder": "label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "ProcessType",
      "placeholder": "process_type",
      "path": "processType",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "ApiVersion",
      "placeholder": "api_version",
      "path": "apiVersion",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "Description",
      "placeholder": "description",
      "path": "description",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "StatusXml",
      "placeholder": "status_xml",
      "path": "status",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    }
  ],
  "tables": [
    {
      "markdownSection": "Variáveis de entrada",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "variables",
        "where": [
          {
            "path": "isInput",
            "equals": "true"
          }
        ],
        "columns": {
          "variable": "name",
          "data_type": "dataType",
          "object_type": "objectType",
          "is_collection": "isCollection"
        }
      }
    },
    {
      "markdownSection": "Variáveis de saída",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "variables",
        "where": [
          {
            "path": "isOutput",
            "equals": "true"
          }
        ],
        "columns": {
          "variable": "name",
          "data_type": "dataType",
          "object_type": "objectType",
          "is_collection": "isCollection"
        }
      }
    },
    {
      "markdownSection": "Dados internos",
      "builder": "internal_rows",
      "source": "Tooling API",
      "args": {
        "columns": {
          "internal_version": "VersionNumber",
          "internal_status": "Status",
          "internal_id": "Id"
        }
      },
      "emptyValue": "Não informado",
      "notes": "Versões do Flow (Tooling API, objeto Flow), do internalData do Flow."
    },
    {
      "markdownSection": "Acesso e configuração",
      "builder": "access_rows",
      "source": "XML",
      "args": {
        "accessKey": "Flow"
      },
      "emptyValue": "Não informado",
      "notes": "Onde o componente está configurado: perfis, permission sets e permission set groups (via) que concedem acesso, a partir do XML (accessSources, passo 6b). Sem índice de acesso: 'Não informado'."
    }
  ],
  "evidence": [
    "Metadata API Flow: campo `start` (API 47+) confirmado via índice oficial; demais elementos validados só por fixture simulada — página Flow da API 67.0 pendente de leitura direta"

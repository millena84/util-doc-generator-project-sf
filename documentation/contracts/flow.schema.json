{
  "metadataType": "Flow",
  "apiVersion": "67.0",
  "documentStrategy": "SINGLE_DOCUMENT_PER_FLOW_WITH_RELATED_COMPONENTS",
  "xmlFilePattern": "**/*.flow-meta.xml",
  "template": "modelo-doc-flow-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "properties": [
    {
      "name": "DeveloperName",
      "placeholder": "developer_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "fullName do componente (nome do arquivo XML recuperado pelo retrieve)."
    },
    {
      "name": "MasterLabel",
      "placeholder": "master_label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "Elemento <label> do Flow (Metadata API Flow.label)."
    },
    {
      "name": "ProcessType",
      "placeholder": "process_type",
      "path": "processType",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "ApiVersion",
      "placeholder": "api_version",
      "path": "apiVersion",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "Description",
      "placeholder": "description",
      "path": "description",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "StatusXml",
      "placeholder": "status_xml",
      "path": "status",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação",
      "notes": "Elemento <status> do XML recuperado (versão retornada pelo retrieve)."
    },
    {
      "name": "Status",
      "placeholder": "status",
      "path": "internal:records",
      "source": "Objeto interno",
      "required": false,
      "markdownSection": "Identificação",
      "format": "v{VersionNumber}: {Status}",
      "notes": "Status de cada versão do Flow (Tooling API, objeto Flow)."
    }
  ],
  "blocks": [
    {
      "placeholder": "flow_definition",
      "markdownSection": "Definição",
      "builder": "related_properties_table",
      "args": {
        "metadataType": "FlowDefinition"
      },
      "source": "XML"
    }
  ],
  "tables": [
    {
      "markdownSection": "Componentes relacionados",
      "builder": "related_components",
      "source": "XML",
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Dados internos",
      "builder": "internal_rows",
      "source": "Tooling API",
      "args": {
        "columns": {
          "internal_version": "VersionNumber",
          "internal_status": "Status",
          "internal_id": "Id"
        }
      },
      "emptyValue": "Não informado",
      "notes": "Versões do Flow (Tooling API, objeto Flow), do internalData do Flow."
    },
    {
      "markdownSection": "Acesso e configuração",
      "builder": "access_rows",
      "source": "XML",
      "args": {
        "accessKey": "Flow"
      },
      "emptyValue": "Não informado",
      "notes": "Onde o componente está configurado: perfis, permission sets e permission set groups (via) que concedem acesso, a partir do XML (accessSources, passo 6b). Sem índice de acesso: 'Não informado'."
    }
  ],
  "relatedMetadataTypes": [
    "FlowDefinition"
  ],
  "internalData": {
    "enabled": true,
    "source": "Tooling API",
    "object": "Flow",
    "useToolingApi": true,
    "query": "SELECT Id, VersionNumber, Status FROM Flow WHERE Definition.DeveloperName = '{developerName}' ORDER BY VersionNumber",
    "blocking": false,
    "validationPending": "Confirmar no piloto que o filtro Definition.DeveloperName é aceito pela Tooling API da org."
  },
  "referenceDoc": "_sf_utilities/ajudAI/contexto-flow-trigger.md, contexto-flow-screen.md, contexto-flow-autolaunched.md",
  "evidence": [

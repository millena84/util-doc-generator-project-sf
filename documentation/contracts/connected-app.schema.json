{
  "metadataType": "ConnectedApp",
  "apiVersion": "67.0",
  "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
  "xmlFilePattern": "**/*.connectedApp-meta.xml",
  "template": "modelo-doc-connectedapp-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "properties": [
    {
      "name": "DeveloperName",
      "placeholder": "developer_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "fullName do componente (nome do arquivo XML recuperado pelo retrieve)."
    },
    {
      "name": "Label",
      "placeholder": "label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "ApiVersion",
      "placeholder": "api_version",
      "path": "apiVersion",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    }
  ],
  "tables": [
    {
      "markdownSection": "OAuth",
      "builder": "child_properties",
      "source": "XML",
      "args": {
        "path": "oauthConfig",
        "keyPlaceholder": "oauth_property",
        "valuePlaceholder": "value",
        "allow": [
          "scopes"
        ]
      },
      "notes": "Somente propriedades em `allow` são renderizadas; as demais (callbackUrl, consumerKey, certificate...) são omitidas e registradas em omittedProperties do run."
    }
  ],
  "relatedMetadataTypes": [],
  "internalData": {
    "enabled": false,
    "source": null,
    "object": null,
    "query": null
  },
  "referenceDoc": "_sf_utilities/ajudAI/contexto-connected-app.md",
  "security": "consumerKey, callbackUrl, certificate, contactEmail/Phone em omitFromDocumentation; consumerSecret em sensitiveXmlElements.",
  "notSupported": [
    "ConnectedAppPolicies via Tooling API: objeto não confirmado",
    "samlConfig/canvasConfig: campos pendentes",
    "Permission Sets/Profiles autorizados: exigem outros metadata types"
  ]
}

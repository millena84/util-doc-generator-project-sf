    {
      "name": "Objeto",
      "placeholder": "sharing_object",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "SharingRules tem um arquivo por objeto."
    }
  ],
  "tables": [
    {
      "markdownSection": "Regras por critério",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "sharingCriteriaRules",
        "columns": {
          "rule_name": "fullName",
          "rule_label": "label",
          "rule_access": "accessLevel",
          "rule_shared_to": "sharedTo",
          "rule_criteria": "criteriaItems",
          "rule_logic": "booleanFilter"
        }
      },
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Regras por proprietário",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "sharingOwnerRules",
        "columns": {
          "rule_name": "fullName",
          "rule_label": "label",
          "rule_access": "accessLevel",
          "rule_shared_to": "sharedTo",
          "rule_shared_from": "sharedFrom"
        }
      },
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Padrão de compartilhamento do objeto (OWD)",
      "builder": "index_record_rows",
      "source": "XML",
      "args": {
        "metadataType": "CustomObject",
        "namePlaceholder": "owd_object",
        "columns": {
          "owd_internal": "sharingModel",
          "owd_external": "externalSharingModel"
        },
        "only": "self"
      },
      "emptyValue": "Não informado",
      "notes": "Do XML do CustomObject, quando o objeto foi processado na execução."
    },
    {
      "markdownSection": "Acesso e configuração",
      "builder": "access_rows",
      "source": "XML",
      "args": {
        "notApplicable": "Regras de compartilhamento não são concedidas por perfil ou permission set"
      },
      "emptyValue": "Não informado",
      "notes": "Sem concessão por perfil/permission set."
    }
  ],
  "internalData": {
    "enabled": false
  },

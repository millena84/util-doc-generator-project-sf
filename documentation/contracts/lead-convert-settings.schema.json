          {
            "path": "leadConvert.sourceFieldNames",
            "accessKey": "CustomField",
            "via": "Campo de origem {name}"
          },
          {
            "path": "leadConvert.targetFieldNames",
            "accessKey": "CustomField",
            "via": "Campo de destino {name}"
          }
        ]

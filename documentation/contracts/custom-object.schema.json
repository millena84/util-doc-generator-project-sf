{
  "metadataType": "CustomObject",
  "apiVersion": "67.0",
  "documentStrategy": "SINGLE_DOCUMENT_PER_OBJECT_WITH_RELATED_COMPONENTS",
  "xmlFilePattern": "**/*.object-meta.xml",
  "template": "modelo-doc-custom-object-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "properties": [
    {
      "name": "DeveloperName",
      "placeholder": "developer_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "fullName do componente (nome do arquivo XML recuperado pelo retrieve)."
    },
    {
      "name": "Label",
      "placeholder": "label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "PluralLabel",
      "placeholder": "plural_label",
      "path": "pluralLabel",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "SharingModel",
      "placeholder": "sharing_model",
      "path": "sharingModel",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "DeploymentStatus",
      "placeholder": "deployment_status",
      "path": "deploymentStatus",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    }
  ],
  "tables": [
    {
      "markdownSection": "Custom Fields",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "CustomField",
        "columns": {
          "field": "fullName",
          "label": "label",
          "type": "type"
        }
      }
    },
    {
      "markdownSection": "Validation Rules",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "ValidationRule",
        "columns": {
          "rule": "@fullName",
          "active": "active",
          "condition": "errorConditionFormula",
          "error_message": "errorMessage"
        }
      }
    },
    {
      "markdownSection": "Record Types",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "RecordType",
        "columns": {
          "record_type": "@fullName",
          "label": "label",
          "active": "active"
        }
      }
    },
    {
      "markdownSection": "Componentes relacionados",
      "builder": "related_components",
      "source": "XML",
      "args": {
        "excludeTypes": [
          "CustomField",
          "ValidationRule",
          "RecordType"
        ]
      }
    }
  ],
  "relatedMetadataTypes": [
    "CustomField",
    "RecordType",
    "ValidationRule",
    "WebLink"
  ],
  "internalData": {
    "enabled": false,
    "source": null,
    "object": null,
    "query": null
  },
  "referenceDoc": "_sf_utilities/ajudAI/contexto-object.md",
  "evidence": [
    "Source format decompõe CustomObject (Salesforce DX: Decomposed Metadata Types); filhos tratados: CustomField, RecordType, ValidationRule, WebLink"
  ],
  "notSupported": [
    "FieldSet, ListView, CompactLayout, BusinessProcess, CustomObjectSharingReason, Index: não confirmado se retornam no retrieve do pai nem configurados",
    "enableStreamingApi descrito como Change Data Capture no ajudAI: não confirmado"
  ]
}

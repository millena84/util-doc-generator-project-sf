{
  "metadataType": "CustomObject",
  "apiVersion": "67.0",
  "documentStrategy": "SINGLE_DOCUMENT_PER_OBJECT_WITH_RELATED_COMPONENTS",
  "xmlFilePattern": "**/*.object-meta.xml",
  "template": "modelo-doc-custom-object-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "properties": [
    {
      "name": "DeveloperName",
      "placeholder": "developer_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação",
      "notes": "fullName do componente (nome do arquivo XML recuperado pelo retrieve)."
    },
    {
      "name": "Label",
      "placeholder": "label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "PluralLabel",
      "placeholder": "plural_label",
      "path": "pluralLabel",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "SharingModel",
      "placeholder": "sharing_model",
      "path": "sharingModel",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "DeploymentStatus",
      "placeholder": "deployment_status",
      "path": "deploymentStatus",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    }
  ],
  "tables": [
    {
      "markdownSection": "Custom Fields",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "CustomField",
        "columns": {
          "field": "fullName",
          "label": "label",
          "type": "type"
        }
      }
    },
    {
      "markdownSection": "Validation Rules",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "ValidationRule",
        "columns": {
          "rule": "@fullName",
          "active": "active",
          "condition": "errorConditionFormula",
          "error_message": "errorMessage"
        }
      }
    },
    {
      "markdownSection": "Record Types",
      "builder": "related_rows",
      "source": "XML",
      "args": {
        "metadataType": "RecordType",
        "columns": {
          "record_type": "@fullName",
          "label": "label",
          "active": "active"
        }
      }
    },
    {
      "markdownSection": "Componentes relacionados",
      "builder": "related_components",
      "source": "XML",
      "args": {
        "excludeTypes": [
          "CustomField",
          "ValidationRule",
          "RecordType"
        ]
      }
    },
    {
      "markdownSection": "Dados internos",
      "builder": "internal_record_properties",
      "source": "Tooling API",
      "args": {
        "keyPlaceholder": "internal_property",
        "valuePlaceholder": "internal_value"
      },
      "emptyValue": "Não informado"
    },
    {
      "markdownSection": "Compartilhamento e filas",
      "builder": "object_sharing_rows",
      "source": "XML",
      "emptyValue": "Não informado",
      "notes": "Filas (Queue.queueSobject) e regras de compartilhamento (SharingRules: role, grupo, fila...) do objeto."
    },
    {
      "markdownSection": "Acesso e configuração",
      "builder": "access_rows",
      "source": "XML",
      "args": {
        "accessKey": "CustomObject"
      },
      "emptyValue": "Não informado",
      "notes": "Onde o componente está configurado: perfis, permission sets e permission set groups (via) que concedem acesso, a partir do XML (accessSources, passo 6b). Sem índice de acesso: 'Não informado'."
    }
  ],
  "relatedMetadataTypes": [
    "CustomField",
    "RecordType",
    "ValidationRule",
    "WebLink"
  ],
  "internalData": {
    "enabled": true,
    "source": "Tooling API",
    "object": "EntityDefinition",
    "useToolingApi": true,
    "query": "SELECT QualifiedApiName, Label, PluralLabel, KeyPrefix, LastModifiedDate FROM EntityDefinition WHERE QualifiedApiName = '{fullName}'",
    "expectSingleRecord": true,
    "blocking": false,
    "validationPending": "Campos conforme Tooling API e Field Reference (EntityDefinition); confirmar no piloto que a consulta é aceita pela org."
  },
  "referenceDoc": "_sf_utilities/ajudAI/contexto-object.md",
  "evidence": [
    "Source format decompõe CustomObject (Salesforce DX: Decomposed Metadata Types); filhos tratados: CustomField, RecordType, ValidationRule, WebLink"
  ],
  "notSupported": [
    "FieldSet, ListView, CompactLayout, BusinessProcess, CustomObjectSharingReason, Index: não confirmado se retornam no retrieve do pai nem configurados",
    "enableStreamingApi descrito como Change Data Capture no ajudAI: não confirmado"
  ]
}

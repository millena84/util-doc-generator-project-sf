    }
  ],
  "internalData": {
    "enabled": true,
    "source": "Objeto interno",
    "object": "PermissionSet",
    "useToolingApi": false,
    "query": "SELECT Id, Name, Label, IsOwnedByProfile, CreatedDate, LastModifiedDate FROM PermissionSet WHERE Name = '{developerName}'",
    "expectSingleRecord": true,
    "blocking": false,
    "validationPending": "Objeto PermissionSet (SOAP/REST API): confirmar campos no piloto."
  },
  "evidence": [

{
  "metadataType": "PermissionSet",
  "apiVersion": "67.0",
  "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
  "xmlFilePattern": "**/*.permissionset-meta.xml",
  "template": "modelo-doc-permission-set-vapi-{apiMajor}.md",
  "titlePath": "@fullName",
  "classification": "Documento de cada permission set. O XML vem do retrieve de acesso (passo 6b), recuperado junto com os componentes documentados, para conter as permissões desses componentes.",
  "properties": [
    {
      "name": "Name",
      "placeholder": "ps_name",
      "path": "@fullName",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "Label",
      "placeholder": "label",
      "path": "label",
      "source": "XML",
      "required": true,
      "markdownSection": "Identificação"
    },
    {
      "name": "Description",
      "placeholder": "description",
      "path": "description",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "License",
      "placeholder": "license",
      "path": "license",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    },
    {
      "name": "HasActivationRequired",
      "placeholder": "has_activation_required",
      "path": "hasActivationRequired",
      "source": "XML",
      "required": false,
      "markdownSection": "Identificação"
    }
  ],
  "tables": [
    {
      "markdownSection": "Objetos",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "objectPermissions",
        "columns": {
          "object": "object",
          "allow_read": "allowRead",
          "allow_create": "allowCreate",
          "allow_edit": "allowEdit",
          "allow_delete": "allowDelete",
          "view_all": "viewAllRecords",
          "modify_all": "modifyAllRecords"
        }
      },
      "emptyValue": "Não aplicável",
      "notes": "objectPermissions (a confirmar no piloto)."
    },
    {
      "markdownSection": "Campos",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "fieldPermissions",
        "columns": {
          "field": "field",
          "readable": "readable",
          "editable": "editable"
        }
      },
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Classes Apex",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "classAccesses",
        "columns": {
          "apex_class": "apexClass"
        },
        "where": [
          {
            "path": "enabled",
            "equals": "true"
          }
        ]
      },
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Flows",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "flowAccesses",
        "columns": {
          "flow": "flow"
        },
        "where": [
          {
            "path": "enabled",
            "equals": "true"
          }
        ]
      },
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Custom Metadata Types",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "customMetadataTypeAccesses",
        "columns": {
          "cmdt": "name"
        },
        "where": [
          {
            "path": "enabled",
            "equals": "true"
          }
        ]
      },
      "emptyValue": "Não aplicável"
    },
    {
      "markdownSection": "Record types",
      "builder": "path_rows",
      "source": "XML",
      "args": {
        "path": "recordTypeVisibilities",

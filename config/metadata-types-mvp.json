{
  "mvp": true,
  "orgAlias": "dev",
  "apiVersion": "67.0",
  "metadataTypeSettings": {
    "Flow": { "folder": "flows" },
    "FlowDefinition": { "folder": "flow-definitions" },
    "ExternalClientApplication": {
      "folder": "external-client-apps",
      "contract": "external-client-app.schema.json",
      "documentSlug": "external-client-app"
    },
    "ExternalCredential": { "folder": "external-credentials" },
    "ConnectedApp": { "folder": "connected-apps" },
    "CustomObject": { "folder": "custom-objects" },
    "CustomMetadata": { "folder": "custom-metadata" },
    "NamedCredential": { "folder": "named-credentials" },
    "RemoteSiteSetting": { "folder": "remote-site-settings" },
    "Certificate": { "folder": "certificates" },
    "PermissionSet": {
      "folder": "permission-sets",
      "contract": "permission-set.schema.json",
      "documentSlug": "permission-set"
    },
    "ApexClass": {
      "folder": "apex-classes",
      "contract": "apex-class.schema.json",
      "documentSlug": "apex-class",
      "sourceParser": { "name": "apex", "suffix": ".cls", "key": "apex" }
    },
    "ApexTrigger": {
      "folder": "apex-triggers",
      "contract": "apex-trigger.schema.json",
      "documentSlug": "apex-trigger",
      "sourceParser": { "name": "apex-trigger", "suffix": ".trigger", "key": "apex" }
    },
    "LightningComponentBundle": {
      "folder": "lwc",
      "contract": "lwc.schema.json",
      "documentSlug": "lwc",
      "sourceParser": { "name": "lwc", "suffix": [".js", ".html", ".css", ".svg", ".js-meta.xml"], "key": "lwc", "bundle": true }
    },
    "Profile": { "folder": "profiles", "contract": "profile.schema.json", "documentSlug": "profile" },
    "PermissionSetGroup": { "folder": "permission-set-groups", "contract": "permission-set-group.schema.json", "documentSlug": "permission-set-group" },
    "SharingRules": { "folder": "sharing-rules", "contract": "sharing-rules.schema.json", "documentSlug": "sharing-rules" },
    "Role": { "folder": "roles", "contract": "role.schema.json", "documentSlug": "role" },
    "Group": { "folder": "public-groups", "contract": "public-group.schema.json", "documentSlug": "public-group" },
    "SecuritySettings": { "folder": "org-security", "contract": "org-security.schema.json", "documentSlug": "org-security" },
    "FlexiPage": {
      "folder": "flexipages",
      "contract": "flexipage.schema.json",
      "documentSlug": "flexipage",
      "sourceParser": { "name": "flexipage", "suffix": ".flexipage-meta.xml", "key": "flexipage" }
    },
    "PlatformEventChannelMember": {
      "folder": "platform-event-channel-members",
      "contract": "change-data-capture.schema.json",
      "documentSlug": "change-data-capture",
      "sourceParser": { "name": "event-channel-member", "suffix": ".platformEventChannelMember-meta.xml", "key": "cdc" }
    },
    "CustomField": { "retrievedWith": "CustomObject" },
    "RecordType": { "retrievedWith": "CustomObject" },
    "ValidationRule": { "retrievedWith": "CustomObject" },
    "WebLink": { "retrievedWith": "CustomObject" }
  },
  "excludedMetadataTypes": [
    {
      "metadataType": "ExtlClntAppGlobalOauthSettings",
      "reason": "Contém consumerKey/consumerSecret. A documentação oficial (Metadata API, ExtlClntAppGlobalOauthSettings) indica que não deve ser adicionado a controle de versão."
    }
  ],
  "sensitiveXmlElements": [
    "consumerSecret",
    "privateKey",
    "password",
    "secret",
    "accessToken",
    "refreshToken",
    "oauthToken",
    "oauthRefreshToken"
  ],
  "omitFromDocumentation": [
    "consumerKey",
    "callbackUrl",
    "contactEmail",
    "contactPhone",
    "certificate",
    "jsonWebKey",
    "parameterValue",
    "clientCredentialsFlowUser",
    "executeHandlerAs",
    "principal",
    "endpoint"
  ],
  "accessSources": {
    "notes": "Onde cada componente está configurado (perfil, permission set, permission set group, fila, regra de compartilhamento). Fonte: XML. Os tipos abaixo são recuperados num retrieve único junto com os componentes documentados, para que o XML do Profile/PermissionSet traga as permissões desses componentes.",
    "enabled": true,
    "folder": "access",
    "retrieveTypes": ["Profile", "PermissionSet", "PermissionSetGroup", "Queue", "SharingRules", "CustomApplication", "PlatformEventSubscriberConfig"],
    "grantContainers": { "Profile": "Perfil", "PermissionSet": "Permission Set" },
    "grants": [
      { "element": "classAccesses", "nameField": "apexClass", "enabledField": "enabled", "accessKey": "ApexClass", "accessLabel": "Executar" },
      { "element": "flowAccesses", "nameField": "flow", "enabledField": "enabled", "accessKey": "Flow", "accessLabel": "Executar" },
      { "element": "objectPermissions", "nameField": "object", "accessKey": "CustomObject",
        "flags": { "allowRead": "Ler", "allowCreate": "Criar", "allowEdit": "Editar", "allowDelete": "Excluir", "viewAllRecords": "Ver todos", "modifyAllRecords": "Modificar todos" } },
      { "element": "fieldPermissions", "nameField": "field", "accessKey": "CustomField",
        "flags": { "readable": "Ler", "editable": "Editar" } },
      { "element": "recordTypeVisibilities", "nameField": "recordType", "enabledField": "visible", "accessKey": "RecordType", "accessLabel": "Visível" },
      { "element": "customMetadataTypeAccesses", "nameField": "name", "enabledField": "enabled", "accessKey": "CustomMetadataType", "accessLabel": "Ler" },
      { "element": "externalCredentialPrincipalAccesses", "nameField": "externalCredentialPrincipal", "enabledField": "enabled", "accessKey": "ExternalCredentialPrincipal", "accessLabel": "Usar principal" },
      { "element": "customPermissions", "nameField": "name", "enabledField": "enabled", "accessKey": "CustomPermission", "accessLabel": "Habilitada" },
      { "element": "userPermissions", "nameField": "name", "enabledField": "enabled", "accessKey": "UserPermission", "accessLabel": "Habilitada" }
    ],
    "permissionSetGroups": { "metadataType": "PermissionSetGroup", "element": "permissionSets", "label": "Permission Set Group" },
    "queues": { "metadataType": "Queue", "element": "queueSobject", "field": "sobjectType", "label": "Fila" },
    "sharingRules": {
      "metadataType": "SharingRules",
      "elements": { "sharingCriteriaRules": "Regra de compartilhamento por critério", "sharingOwnerRules": "Regra de compartilhamento por proprietário" },
      "sharedTo": "sharedTo",
      "accessLevel": "accessLevel"
    },
    "pageAssignments": {
      "notes": "Ativação de páginas Lightning por app (actionOverrides) e por app + perfil/record type (profileActionOverrides) no XML do CustomApplication.",
      "metadataType": "CustomApplication",
      "elements": { "actionOverrides": "Padrão do app", "profileActionOverrides": "App + perfil" },
      "typeField": "type",
      "typeValue": "Flexipage",
      "contentField": "content",
      "fields": ["actionName", "formFactor", "pageOrSobjectType", "profile", "recordType"]
    },
    "subscriberConfigs": {
      "notes": "Usuário e lote das triggers de platform event / change event. O usuário configurado nunca é documentado: só se há um.",
      "metadataType": "PlatformEventSubscriberConfig",
      "consumerField": "platformEventConsumer",
      "batchSizeField": "batchSize",
      "userField": "user"
    },
    "validationPending": "objectPermissions, PermissionSetGroup.permissionSets, SharingRules.sharedTo, customPermissions (name/enabled), CustomApplication.profileActionOverrides, PlatformEventSubscriberConfig (platformEventConsumer/batchSize/user) e o formato de externalCredentialPrincipal não confirmados nesta adaptação; confirmar no piloto (documentation/piloto-org-real.md)."
  },
  "automationIndex": {
    "notes": "Automações que convivem no mesmo objeto (documento de Apex Trigger). Fonte: XML/código dos componentes processados na execução. Fases na ordem oficial de execução; 'order' null = posição relativa não confirmada nesta adaptação.",
    "officialReference": "https://developer.salesforce.com/docs/atlas.en-us.apexcode.meta/apexcode/apex_triggers_order_of_execution.htm",
    "phases": [
      { "key": "flowBeforeSave", "order": 1, "label": "Flow before-save (antes de salvar)", "orderValueLabel": "triggerOrder", "note": "Entre flows do objeto: triggerOrder 1–1000, depois sem valor, depois 1001–2000; empate pelo nome de API" },
      { "key": "triggerBefore", "order": 2, "label": "Trigger before (insert/update)", "note": "Sem ordem garantida entre triggers do mesmo objeto e evento" },
      { "key": "validation", "order": 3, "label": "Regras de validação", "note": "Após as triggers before; só em insert/update" },
      { "key": "triggerAfter", "order": 4, "label": "Trigger after (insert/update)", "note": "Sem ordem garantida entre triggers do mesmo objeto e evento" },
      { "key": "flowAfterSave", "order": 5, "label": "Flow after-save (após salvar)", "orderValueLabel": "triggerOrder", "note": "Entre flows do objeto: triggerOrder 1–1000, depois sem valor, depois 1001–2000; empate pelo nome de API" },
      { "key": "flowBeforeDelete", "order": null, "label": "Flow before-delete (antes de excluir)", "orderValueLabel": "triggerOrder" },
      { "key": "triggerBeforeDelete", "order": null, "label": "Trigger before delete", "note": "Sem ordem garantida entre triggers do mesmo objeto e evento" },
      { "key": "triggerAfterDelete", "order": null, "label": "Trigger after delete", "note": "Sem ordem garantida entre triggers do mesmo objeto e evento" },
      { "key": "triggerAfterUndelete", "order": null, "label": "Trigger after undelete", "note": "Sem ordem garantida entre triggers do mesmo objeto e evento" }
    ],
    "sources": [
      { "metadataType": "Flow", "label": "Record-Triggered Flow", "objectPath": "start.object",
        "phaseByPath": { "path": "start.triggerType", "map": { "RecordBeforeSave": "flowBeforeSave", "RecordAfterSave": "flowAfterSave", "RecordBeforeDelete": "flowBeforeDelete" } },
        "eventsPath": "start.recordTriggerType", "statusPath": "status", "orderPath": "triggerOrder" },
      { "metadataType": "ApexTrigger", "label": "Apex Trigger", "objectPath": "apex.sObject",
        "phaseByEvent": { "path": "apex.events", "map": { "before insert": "triggerBefore", "before update": "triggerBefore", "after insert": "triggerAfter", "after update": "triggerAfter", "before delete": "triggerBeforeDelete", "after delete": "triggerAfterDelete", "after undelete": "triggerAfterUndelete" } },
        "eventsPath": "apex.events", "statusPath": "status" },
      { "metadataType": "ValidationRule", "label": "Regra de validação", "objectPath": "@parent", "phase": "validation", "statusPath": "active" }
    ],
    "validationPending": "Flow.triggerOrder e a posição relativa das fases de exclusão (delete/undelete) não confirmados nesta adaptação; confirmar no piloto (documentation/piloto-org-real.md)."
  },
  "recordIndex": {
    "notes": "Campos do XML de outros componentes guardados no índice da execução: OWD por objeto (documento de segurança da org e de regras de compartilhamento), parentRole (hierarquia de papéis) e uso/ativação de páginas Lightning (pages).",
    "fields": {
      "CustomObject": ["label", "sharingModel", "externalSharingModel"],
      "Role": ["name", "parentRole"]
    },
    "pages": {
      "notes": "Onde cada componente é usado (FlexiPage processada) e páginas ativadas como padrão da org (actionOverrides do CustomObject processado).",
      "pageType": "FlexiPage",
      "parsedKey": "flexipage",
      "orgDefault": { "metadataType": "CustomObject", "element": "actionOverrides", "typeField": "type", "typeValue": "Flexipage", "contentField": "content", "fields": ["actionName", "formFactor"] }
    },
    "events": {
      "notes": "Quem publica e quem assina cada evento (platform event __e, change event): Apex (EventBus.publish + new X__e), triggers no evento, Flows (start.triggerType PlatformEvent; recordCreates de __e) e LWC (canais /event e /data com lightning/empApi).",
      "suffixes": ["__e", "ChangeEvent"],
      "flowTriggerType": "PlatformEvent",
      "flowCreateElement": "recordCreates"
    }
  },
  "metadataTypeGroups": [
    {
      "group": "Flow",
      "primaryMetadataType": "Flow",
      "relatedMetadataTypes": ["FlowDefinition"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_FLOW_WITH_RELATED_COMPONENTS",
      "relations": [
        { "metadataType": "FlowDefinition", "match": "SAME_FULL_NAME" }
      ],
      "subDocuments": [
        {
          "contract": "flow-trigger.schema.json",
          "when": { "path": "start.triggerType", "present": true },
          "documentSuffix": "flow-trigger"
        },
        {
          "contract": "flow-autolaunched.schema.json",
          "when": [
            { "path": "processType", "equals": "AutoLaunchedFlow" },
            { "path": "start.triggerType", "present": false }
          ],
          "documentSuffix": "flow-autolaunched"
        },
        {
          "contract": "flow-screen.schema.json",
          "forEach": "screens",
          "itemName": "name",
          "documentSuffix": "flow-screen"
        }
      ]
    },
    {
      "group": "ExternalClientApp",
      "primaryMetadataType": "ExternalClientApplication",
      "relatedMetadataTypes": [
        "ExtlClntAppOauthSettings",
        "ExtlClntAppConfigurablePolicies",
        "ExtlClntAppOauthConfigurablePolicies"
      ],
      "documentStrategy": "SINGLE_DOCUMENT_PER_APP_WITH_RELATED_COMPONENTS",
      "relations": [
        { "metadataType": "ExtlClntAppOauthSettings", "match": "FIELD_EQUALS_PRIMARY", "field": "externalClientApplication" },
        { "metadataType": "ExtlClntAppConfigurablePolicies", "match": "FIELD_EQUALS_PRIMARY", "field": "externalClientApplication" },
        { "metadataType": "ExtlClntAppOauthConfigurablePolicies", "match": "FIELD_EQUALS_PRIMARY", "field": "externalClientApplication" }
      ]
    },
    {
      "group": "ExternalCredential",
      "primaryMetadataType": "ExternalCredential",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "ConnectedApp",
      "primaryMetadataType": "ConnectedApp",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "CustomObject",
      "primaryMetadataType": "CustomObject",
      "relatedMetadataTypes": ["CustomField", "RecordType", "ValidationRule", "WebLink"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_OBJECT_WITH_RELATED_COMPONENTS",
      "componentFilter": { "includeRegex": "__c$" },
      "relations": [
        { "metadataType": "CustomField", "match": "CHILD_OF_PRIMARY" },
        { "metadataType": "RecordType", "match": "CHILD_OF_PRIMARY" },
        { "metadataType": "ValidationRule", "match": "CHILD_OF_PRIMARY" },
        { "metadataType": "WebLink", "match": "CHILD_OF_PRIMARY" }
      ]
    },
    {
      "group": "CustomMetadata",
      "primaryMetadataType": "CustomMetadata",
      "relatedMetadataTypes": ["CustomField"],
      "documentStrategy": "ONE_DOCUMENT_PER_TYPE_AND_RECORDS",
      "relations": [
        { "metadataType": "CustomField", "match": "CHILD_OF_PRIMARY" }
      ],
      "typeDefinition": {
        "metadataType": "CustomObject",
        "typeNameSuffix": "__mdt",
        "recordSeparator": "."
      }
    },
    {
      "group": "NamedCredential",
      "primaryMetadataType": "NamedCredential",
      "relatedMetadataTypes": ["ExternalCredential"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_NAMED_CREDENTIAL_WITH_RELATED_COMPONENTS",
      "relations": [
        {
          "metadataType": "ExternalCredential",
          "match": "PRIMARY_FIELD_REFERENCES",
          "field": "namedCredentialParameters.externalCredential"
        }
      ]
    },
    {
      "group": "RemoteSiteSetting",
      "primaryMetadataType": "RemoteSiteSetting",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "Certificate",
      "primaryMetadataType": "Certificate",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "ApexClass",
      "primaryMetadataType": "ApexClass",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-apex.md",
      "componentFilter": {
        "excludeRegex": "^[A-Za-z0-9]+__",
        "notes": "Classes de pacote gerenciado (ns__Classe) não têm código-fonte recuperável."
      },
      "subDocuments": [
        {
          "contract": "apex-batch.schema.json",
          "when": { "path": "apex.implements", "contains": "Database.Batchable" },
          "documentSuffix": "apex-batch"
        },
        {
          "contract": "apex-queueable.schema.json",
          "when": { "path": "apex.implements", "contains": "System.Queueable" },
          "documentSuffix": "apex-queueable"
        },
        {
          "contract": "apex-scheduler.schema.json",
          "when": { "path": "apex.implements", "contains": "System.Schedulable" },
          "documentSuffix": "apex-scheduler"
        },
        {
          "contract": "apex-future.schema.json",
          "forEach": "apex.futureMethods",
          "itemName": "name",
          "documentSuffix": "apex-future"
        }
      ]
    },
    {
      "group": "ApexTrigger",
      "primaryMetadataType": "ApexTrigger",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-apex-trigger.md",
      "usesRunIndex": true,
      "lookupInventories": ["ApexClass"],
      "componentFilter": {
        "excludeRegex": "^[A-Za-z0-9]+__",
        "notes": "Triggers de pacote gerenciado (ns__Trigger) não têm código-fonte recuperável."
      },
      "notes": "Processado depois dos demais grupos: a seção de coexistência mostra Flows, regras de validação e triggers do mesmo objeto processados na execução (automationIndex). lookupInventories lista ApexClass só para conferir se o nome chamado é classe da org."
    },
    {
      "group": "LightningComponentBundle",
      "primaryMetadataType": "LightningComponentBundle",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-lwc.md",
      "usesRunIndex": true,
      "componentFilter": {
        "excludeRegex": "^[A-Za-z0-9]+__",
        "notes": "Componentes de pacote gerenciado (ns__componente) não têm código-fonte recuperável."
      },
      "notes": "Bundle lido inteiro (sourceParser bundle). Processado depois dos demais grupos: a verificação dos métodos Apex chamados usa as classes processadas na execução (usesRunIndex).",
      "subDocuments": [
        {
          "contract": "lwc-quick-action.schema.json",
          "when": { "path": "lwc.targets", "contains": "lightning__RecordAction" },
          "documentSuffix": "lwc-quick-action"
        },
        {
          "contract": "lwc-flow-screen.schema.json",
          "when": { "path": "lwc.targets", "contains": "lightning__FlowScreen" },
          "documentSuffix": "lwc-flow-screen"
        }
      ]
    },
    {
      "group": "FlexiPage",
      "primaryMetadataType": "FlexiPage",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-flexipage.md",
      "usesRunIndex": true,
      "componentFilter": {
        "excludeRegex": "^[A-Za-z0-9]+__",
        "notes": "Páginas de pacote gerenciado (ns__Pagina) ficam fora."
      },
      "notes": "XML achatado pelo sourceParser flexipage. Processado com os grupos que usam o índice: o documento do LWC mostra as páginas que o usam; a ativação vem do CustomObject processado (padrão da org) e do CustomApplication (passo 6b)."
    },
    {
      "group": "PlatformEvent",
      "primaryMetadataType": "CustomObject",
      "relatedMetadataTypes": ["CustomField"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_OBJECT_WITH_RELATED_COMPONENTS",
      "contract": "platform-event.schema.json",
      "documentSlug": "platform-event",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-platform-objects.md",
      "componentFilter": { "includeRegex": "__e$", "notes": "Platform events são CustomObject com sufixo __e; o grupo CustomObject fica com __c." },
      "relations": [ { "metadataType": "CustomField", "match": "CHILD_OF_PRIMARY" } ],
      "usesRunIndex": true,
      "notes": "Publicadores e assinantes vêm dos componentes processados na execução (recordIndex.events); configuração das triggers assinantes, de PlatformEventSubscriberConfig (passo 6b)."
    },
    {
      "group": "ChangeDataCapture",
      "primaryMetadataType": "PlatformEventChannelMember",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-platform-objects.md",
      "usesRunIndex": true,
      "notes": "Objetos selecionados para Change Data Capture (canal padrão ChangeEvents ou customizado), enriquecimento e filtro. Um documento por membro de canal."
    },
    {
      "group": "PermissionSet",
      "primaryMetadataType": "PermissionSet",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "notes": "XML reaproveitado do retrieve de acesso (passo 6b): vem completo, com as permissões dos componentes documentados."
    },
    {
      "group": "Profile",
      "primaryMetadataType": "Profile",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-seg-controle-acesso-gov.md",
      "notes": "XML reaproveitado do retrieve de acesso (passo 6b): traz as permissões dos componentes recuperados no mesmo pedido."
    },
    {
      "group": "PermissionSetGroup",
      "primaryMetadataType": "PermissionSetGroup",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-seg-controle-acesso-gov.md",
      "notes": "XML reaproveitado do retrieve de acesso (passo 6b)."
    },
    {
      "group": "SharingRules",
      "primaryMetadataType": "SharingRules",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-seg-controle-acesso-gov.md",
      "usesRunIndex": true,
      "notes": "Um documento por objeto. XML reaproveitado do retrieve de acesso (passo 6b); OWD do objeto vem do CustomObject processado na execução."
    },
    {
      "group": "Role",
      "primaryMetadataType": "Role",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-seg-controle-acesso-gov.md",
      "usesRunIndex": true,
      "notes": "Hierarquia (parentRole) montada com todos os papéis processados na execução."
    },
    {
      "group": "PublicGroup",
      "primaryMetadataType": "Group",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-seg-controle-acesso-gov.md",
      "notes": "Grupos públicos. Membros não são documentados (proteção de dados)."
    },
    {
      "group": "OrgSecurity",
      "primaryMetadataType": "SecuritySettings",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_ORG",
      "referenceDoc": "_sf_utilities/ajudAI/contexto-seg-controle-acesso-gov.md",
      "fixedComponents": [ { "fullName": "Security", "retrieveType": "Settings" } ],
      "usesRunIndex": true,
      "notes": "Documento único da org: Settings:Security (sem inventário) + OWD dos CustomObject processados + Organization (dados internos). Forma do retrieve (Settings:Security) e o tipo listado em metadata-types a confirmar no piloto."
    }
  ]
}

{
  "mvp": true,
  "orgAlias": "dev",
  "apiVersion": "67.0",
  "metadataTypeSettings": {
    "Flow": { "folder": "flows" },
    "FlowDefinition": { "folder": "flow-definitions" },
    "ExternalClientApplication": {
      "folder": "external-client-apps",
      "contract": "external-client-app.schema.json",
      "documentSlug": "external-client-app"
    },
    "ExternalCredential": { "folder": "external-credentials" },
    "ConnectedApp": { "folder": "connected-apps" },
    "CustomObject": { "folder": "custom-objects" },
    "CustomMetadata": { "folder": "custom-metadata" },
    "NamedCredential": { "folder": "named-credentials" },
    "RemoteSiteSetting": { "folder": "remote-site-settings" },
    "Certificate": { "folder": "certificates" },
    "CustomField": { "retrievedWith": "CustomObject" },
    "RecordType": { "retrievedWith": "CustomObject" },
    "ValidationRule": { "retrievedWith": "CustomObject" },
    "WebLink": { "retrievedWith": "CustomObject" }
  },
  "excludedMetadataTypes": [
    {
      "metadataType": "ExtlClntAppGlobalOauthSettings",
      "reason": "Contém consumerKey/consumerSecret. A documentação oficial (Metadata API, ExtlClntAppGlobalOauthSettings) indica que não deve ser adicionado a controle de versão."
    }
  ],
  "sensitiveXmlElements": [
    "consumerSecret",
    "privateKey",
    "password",
    "secret",
    "accessToken",
    "refreshToken",
    "oauthToken"
  ],
  "omitFromDocumentation": [
    "consumerKey",
    "callbackUrl",
    "contactEmail",
    "contactPhone",
    "certificate",
    "jsonWebKey",
    "parameterValue",
    "commaSeparatedPermissionSet",
    "commaSeparatedProfile",
    "clientCredentialsFlowUser",
    "executeHandlerAs",
    "principal",
    "endpoint"
  ],
  "metadataTypeGroups": [
    {
      "group": "Flow",
      "primaryMetadataType": "Flow",
      "relatedMetadataTypes": ["FlowDefinition"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_FLOW_WITH_RELATED_COMPONENTS",
      "relations": [
        { "metadataType": "FlowDefinition", "match": "SAME_FULL_NAME" }
      ],
      "subDocuments": [
        {
          "contract": "flow-trigger.schema.json",
          "when": { "path": "start.triggerType", "present": true },
          "documentSuffix": "flow-trigger"
        },
        {
          "contract": "flow-autolaunched.schema.json",
          "when": [
            { "path": "processType", "equals": "AutoLaunchedFlow" },
            { "path": "start.triggerType", "present": false }
          ],
          "documentSuffix": "flow-autolaunched"
        },
        {
          "contract": "flow-screen.schema.json",
          "forEach": "screens",
          "itemName": "name",
          "documentSuffix": "flow-screen"
        }
      ]
    },
    {
      "group": "ExternalClientApp",
      "primaryMetadataType": "ExternalClientApplication",
      "relatedMetadataTypes": [
        "ExtlClntAppOauthSettings",
        "ExtlClntAppConfigurablePolicies",
        "ExtlClntAppOauthConfigurablePolicies"
      ],
      "documentStrategy": "SINGLE_DOCUMENT_PER_APP_WITH_RELATED_COMPONENTS",
      "relations": [
        { "metadataType": "ExtlClntAppOauthSettings", "match": "FIELD_EQUALS_PRIMARY", "field": "externalClientApplication" },
        { "metadataType": "ExtlClntAppConfigurablePolicies", "match": "FIELD_EQUALS_PRIMARY", "field": "externalClientApplication" },
        { "metadataType": "ExtlClntAppOauthConfigurablePolicies", "match": "FIELD_EQUALS_PRIMARY", "field": "externalClientApplication" }
      ]
    },
    {
      "group": "ExternalCredential",
      "primaryMetadataType": "ExternalCredential",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "ConnectedApp",
      "primaryMetadataType": "ConnectedApp",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "CustomObject",
      "primaryMetadataType": "CustomObject",
      "relatedMetadataTypes": ["CustomField", "RecordType", "ValidationRule", "WebLink"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_OBJECT_WITH_RELATED_COMPONENTS",
      "componentFilter": { "includeRegex": "__c$" },
      "relations": [
        { "metadataType": "CustomField", "match": "CHILD_OF_PRIMARY" },
        { "metadataType": "RecordType", "match": "CHILD_OF_PRIMARY" },
        { "metadataType": "ValidationRule", "match": "CHILD_OF_PRIMARY" },
        { "metadataType": "WebLink", "match": "CHILD_OF_PRIMARY" }
      ]
    },
    {
      "group": "CustomMetadata",
      "primaryMetadataType": "CustomMetadata",
      "relatedMetadataTypes": ["CustomField"],
      "documentStrategy": "ONE_DOCUMENT_PER_TYPE_AND_RECORDS",
      "relations": [
        { "metadataType": "CustomField", "match": "CHILD_OF_PRIMARY" }
      ],
      "typeDefinition": {
        "metadataType": "CustomObject",
        "typeNameSuffix": "__mdt",
        "recordSeparator": "."
      }
    },
    {
      "group": "NamedCredential",
      "primaryMetadataType": "NamedCredential",
      "relatedMetadataTypes": ["ExternalCredential"],
      "documentStrategy": "SINGLE_DOCUMENT_PER_NAMED_CREDENTIAL_WITH_RELATED_COMPONENTS",
      "relations": [
        {
          "metadataType": "ExternalCredential",
          "match": "PRIMARY_FIELD_REFERENCES",
          "field": "namedCredentialParameters.externalCredential"
        }
      ]
    },
    {
      "group": "RemoteSiteSetting",
      "primaryMetadataType": "RemoteSiteSetting",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    },
    {
      "group": "Certificate",
      "primaryMetadataType": "Certificate",
      "relatedMetadataTypes": [],
      "documentStrategy": "ONE_DOCUMENT_PER_COMPONENT"
    }
  ]
}
